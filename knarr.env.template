# Knarr CLI configuration — copy to knarr.env and fill in values.
# knarr.env is gitignored.

# Matrix homeserver
KNARR_HOMESERVER=http://matrix.knarr.local
KNARR_ADMIN_USER=admin
KNARR_ADMIN_PASSWORD=

# Bridge operator (the @knarr Matrix user that runs the Discord bridge)
KNARR_BRIDGE_USER=knarr
KNARR_BRIDGE_PASSWORD=

# Bridge management DM room ID (create a DM with @discordbot from Element, note the room ID)
KNARR_MANAGEMENT_ROOM=

# Bridge bot Matrix user ID (default: @discordbot:knarr.local)
# Change if your server_name differs from knarr.local
# KNARR_BRIDGE_BOT_USER=@discordbot:knarr.local

# Discord bot token (from discord.com/developers)
DISCORD_TOKEN=
